# =============================================================================
# Shellius — Production Environment Example
# Copy to .env.prod and fill in all values marked <CHANGE_ME>
# Never commit .env.prod to git.
#
# See docs/DEPLOYMENT.md for the full environment variable reference table,
# `openssl rand` commands for every secret, and upgrade instructions.
# =============================================================================

NODE_ENV=production
PORT=3001

# ---------- Public hostname ---------------------------------------------------
# The domain Shellius is reachable at (used by Traefik labels, CORS, SSO
# callback URLs, and bootstrap script URLs).
TRAEFIK_HOST=shellius.yourdomain.com
PUBLIC_URL=https://shellius.yourdomain.com

# ---------- Bundled infra profiles -------------------------------------------
# Which bundled containers compose starts. Drop a profile to bring your own
# managed service and point the matching var below at it:
#   postgres -> DATABASE_URL | redis -> REDIS_URL | minio -> S3/Azure storage
COMPOSE_PROFILES=postgres,redis,minio

# ---------- PostgreSQL --------------------------------------------------------
# DATABASE_URL is env-only (bootstrap-critical, not configurable in the UI).
# For a managed Postgres: set DATABASE_URL and remove "postgres" from
# COMPOSE_PROFILES (POSTGRES_* are only used by the bundled container).
POSTGRES_USER=shellius
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=shellius
DATABASE_URL=postgresql://shellius:<CHANGE_ME>@postgres:5432/shellius?schema=public

# ---------- Redis -------------------------------------------------------------
# For a managed Redis: set REDIS_URL and remove "redis" from COMPOSE_PROFILES.
REDIS_URL=redis://redis:6379

# ---------- JWT ---------------------------------------------------------------
# Generate both with: openssl rand -hex 32
# The server refuses to start in production with default/example secrets.
JWT_SECRET=<CHANGE_ME>
JWT_REFRESH_SECRET=<CHANGE_ME>
# 8h / 30d is the recommended default for self-hosted single-team deployments
# (no "session expired" prompts during the workday). Tighten to 15m / 7d for a
# hosted multi-tenant instance where reducing stolen-token blast radius
# matters more than UX.
JWT_EXPIRY=8h
JWT_REFRESH_EXPIRY=30d
# Absolute lifetime of a refresh-token family regardless of activity/rotation.
SESSION_ABSOLUTE_TTL=2592000
# Consecutive failed local logins before a temporary account lock.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15

# ---------- Encryption (AES-256-GCM) -----------------------------------------
# Encrypts the CA private key, RDP/keystore credentials, cloud connector
# secrets, and SMTP passwords at rest. Generate with: openssl rand -hex 32
#
# ** BACK THIS UP SOMEWHERE SAFE, SEPARATE FROM YOUR DATABASE BACKUP. **
# ** NEVER CHANGE THIS AFTER GOING TO PRODUCTION — ** every secret already
# encrypted with the old key becomes permanently unreadable (CA key, stored
# credentials, RDP passwords). If you must rotate it, you need a migration
# that decrypts with the old key and re-encrypts with the new one first.
SERVER_ENCRYPTION_KEY=<CHANGE_ME>

# ---------- Host Agent --------------------------------------------------------
# Shared secret target hosts use to authenticate check-principals calls to
# POST /api/certificates/verify. Generate with: openssl rand -hex 32
AGENT_SHARED_SECRET=<CHANGE_ME>
# TODO(security-release): AGENT_SHARED_SECRET is being replaced by per-host
# agent tokens issued at bootstrap time (each host gets its own credential
# instead of one shared secret for the whole fleet). Existing hosts keep
# working against the shared secret in a deprecated compatibility mode after
# upgrading — re-run `scripts/bootstrap.sh --upgrade` on each host to switch
# it to its own token. Document here once the compat-mode env var name and
# the exact bootstrap flag are finalized; this note is a placeholder.

# ---------- SSH outbound target guard ----------
# All outbound SSH (web terminal, key deployment, credential test, Quick
# Connect, provisioning) refuses loopback / link-local / unspecified /
# multicast targets by default. Only set to true for a throwaway lab
# deployment that intentionally SSHes into containers on the Shellius host
# itself. NEVER set this to true in a real production deployment.
SSH_TARGET_ALLOW_LOOPBACK=false

# ---------- Reverse proxy / networking ----------------------------------------
# Trusted proxy hop count in front of the backend (correct client IP for rate
# limiting + audit logs). 1 for the bundled nginx/Traefik, 2 if you add
# another proxy (e.g. Cloudflare) in front of that.
TRUST_PROXY=1

# ---------- Object Storage (session recordings) -------------------------------
# Pluggable: MinIO (bundled) | AWS S3 | Azure Blob. A super_admin can also set
# this at runtime from Settings -> Storage (DB overrides env, no restart).
# For S3/Azure: set STORAGE_PROVIDER + the relevant block and remove "minio"
# from COMPOSE_PROFILES.
# STORAGE_PROVIDER=minio

# -- MinIO (bundled, default) --
MINIO_ACCESS_KEY=<CHANGE_ME>
MINIO_SECRET_KEY=<CHANGE_ME>
MINIO_ENDPOINT=http://minio:9000
MINIO_RECORDINGS_BUCKET=shellius-recordings

# -- AWS S3 (STORAGE_PROVIDER=s3) --
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=shellius-recordings
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=            # blank = AWS regional endpoint

# -- Azure Blob (STORAGE_PROVIDER=azure) --
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=shellius-recordings

# ---------- MFA (two-factor auth) ----------------------------------------------
# Defaults; a super_admin can override per-org from Settings -> MFA. SSO
# logins rely on the identity provider's own MFA. Strongly recommended to
# enforce MFA for admin/super_admin accounts at minimum.
# MFA_ENABLED=false
# MFA_ENFORCED=false
# MFA_ALLOW_TOTP=true
# MFA_ALLOW_EMAIL_OTP=true
# MFA_ISSUER=Shellius

# ---------- SSO — multi-provider env presets (optional) -----------------------
# Prefer configuring providers from Settings -> SSO in the UI (supports
# multiple providers at once, stored in the DB). These env vars are optional
# single-provider presets. See docs/sso-configuration.md.
# SSO_ALLOWED_DOMAINS=yourdomain.com
# SSO_DEFAULT_ROLE=viewer
# SSO_AUTO_PROVISION=true
#
# SSO_GOOGLE_CLIENT_ID=
# SSO_GOOGLE_CLIENT_SECRET=
#
# SSO_ENTRA_TENANT_ID=
# SSO_ENTRA_CLIENT_ID=
# SSO_ENTRA_CLIENT_SECRET=
#
# SSO_OKTA_DOMAIN=your-org.okta.com
# SSO_OKTA_CLIENT_ID=
# SSO_OKTA_CLIENT_SECRET=
#
# SSO_AUTH0_DOMAIN=your-tenant.us.auth0.com
# SSO_AUTH0_CLIENT_ID=
# SSO_AUTH0_CLIENT_SECRET=
#
# -- GitHub (OAuth 2.0), or GitHub Enterprise Server via SSO_ISSUER_URL --
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_ISSUER_URL=

# ---------- Background job concurrency ----------------------------------------
# KEY_DEPLOYMENT_CONCURRENCY=5
# ONBOARDING_CONCURRENCY=5

# ---------- Terminal workspace --------------------------------------------------
# Grace period (seconds) a detached SSH session stays alive before it's ended.
# TERMINAL_DETACH_TTL_SECONDS=900

# ---------- Seed (first-boot only, idempotent after that) --------------------
SEED_ORG_NAME=YavLabs
SEED_ORG_SLUG=yavlabs
SEED_ORG_DOMAIN=yavlabs.com
SEED_ADMIN_EMAIL=admin@yavlabs.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=<CHANGE_ME>

# ---------- Metrics -------------------------------------------------------------
# Enables GET /api/metrics (Prometheus). Generate with: openssl rand -hex 16
METRICS_TOKEN=<CHANGE_ME>

# ---------- SMTP (transactional email) ------------------------------------------
# See docs/smtp-configuration.md. A per-org override can also be set from
# Settings -> Notifications -> SMTP (DB wins over these env defaults).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=
# SMTP_FROM=noreply@shellius.yourdomain.com
# SMTP_SECURE=true

# ---------- Image version (optional pin, default is :latest) -----------------
# SHELLIUS_VERSION=1.1.0
