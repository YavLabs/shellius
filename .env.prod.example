# =============================================================================
# Shellius — Production Environment Example
# Copy to .env.prod and fill in all values marked <CHANGE_ME>
# Never commit .env.prod to git.
# =============================================================================

NODE_ENV=production
PORT=3001

# ---------- Public hostname ---------------------------------------------------
# The domain Shellius is reachable at (used by Traefik + bootstrap scripts).
TRAEFIK_HOST=shellius.yourdomain.com
PUBLIC_URL=https://shellius.yourdomain.com

# ---------- Bundled infra profiles -------------------------------------------
# Which bundled containers compose starts. Drop a profile to bring your own
# managed service and point the matching var below at it:
#   postgres -> DATABASE_URL | redis -> REDIS_URL | minio -> S3/Azure storage
COMPOSE_PROFILES=postgres,redis,minio

# ---------- PostgreSQL --------------------------------------------------------
# DATABASE_URL is env-only (bootstrap-critical, not configurable in the UI).
# For a managed Postgres: set DATABASE_URL and remove "postgres" from
# COMPOSE_PROFILES (POSTGRES_* are only used by the bundled container).
POSTGRES_USER=shellius
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=shellius
DATABASE_URL=postgresql://shellius:<CHANGE_ME>@postgres:5432/shellius?schema=public

# ---------- Redis -------------------------------------------------------------
# For a managed Redis: set REDIS_URL and remove "redis" from COMPOSE_PROFILES.
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- JWT ---------------------------------------------------------------
JWT_SECRET=<CHANGE_ME>
JWT_EXPIRY=8h
JWT_REFRESH_EXPIRY=30d

# ---------- Encryption (AES-256-GCM) -----------------------------------------
ENCRYPTION_KEY=<CHANGE_ME>

# ---------- Host Agent --------------------------------------------------------
AGENT_SHARED_SECRET=<CHANGE_ME>

# ---------- Object Storage (session recordings) -------------------------------
# Pluggable: MinIO (bundled) | AWS S3 | Azure Blob. A super_admin can also set
# this at runtime from Settings -> Storage (DB overrides env, no restart).
# For S3/Azure: set STORAGE_PROVIDER + the relevant block and remove "minio"
# from COMPOSE_PROFILES.
# STORAGE_PROVIDER=minio

# -- MinIO (bundled, default) --
MINIO_ACCESS_KEY=<CHANGE_ME>
MINIO_SECRET_KEY=<CHANGE_ME>
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=shellius-recordings

# -- AWS S3 (STORAGE_PROVIDER=s3) --
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=shellius-recordings
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=            # blank = AWS regional endpoint

# -- Azure Blob (STORAGE_PROVIDER=azure) --
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=shellius-recordings

# ---------- Seed (first-boot only, idempotent after that) --------------------
SEED_ORG_NAME=YavLabs
SEED_ORG_SLUG=yavlabs
SEED_ORG_DOMAIN=yavlabs.com
SEED_ADMIN_EMAIL=admin@yavlabs.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=<CHANGE_ME>

# ---------- Image version (optional pin, default is :latest) -----------------
# SHELLIUS_VERSION=1.2.3
