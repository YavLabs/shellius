# =============================================================================
# Shellius — Production Environment Example
# Copy to .env.prod and fill in all values marked <CHANGE_ME>
# Never commit .env.prod to git.
# =============================================================================

NODE_ENV=production
PORT=3001

# ---------- Public hostname ---------------------------------------------------
# The domain Shellius is reachable at (used by Traefik + bootstrap scripts).
TRAEFIK_HOST=shellius.yourdomain.com
PUBLIC_URL=https://shellius.yourdomain.com

# ---------- PostgreSQL --------------------------------------------------------
POSTGRES_USER=shellius
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=shellius
DATABASE_URL=postgresql://shellius:<CHANGE_ME>@postgres:5432/shellius?schema=public

# ---------- Redis -------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- JWT ---------------------------------------------------------------
JWT_SECRET=<CHANGE_ME>
JWT_EXPIRY=8h
JWT_REFRESH_EXPIRY=30d

# ---------- Encryption (AES-256-GCM) -----------------------------------------
ENCRYPTION_KEY=<CHANGE_ME>

# ---------- Host Agent --------------------------------------------------------
AGENT_SHARED_SECRET=<CHANGE_ME>

# ---------- MinIO (session recordings) ----------------------------------------
MINIO_ACCESS_KEY=<CHANGE_ME>
MINIO_SECRET_KEY=<CHANGE_ME>
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=shellius-recordings

# ---------- Seed (first-boot only, idempotent after that) --------------------
SEED_ORG_NAME=YavLabs
SEED_ORG_SLUG=yavlabs
SEED_ORG_DOMAIN=yavlabs.com
SEED_ADMIN_EMAIL=admin@yavlabs.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=<CHANGE_ME>

# ---------- Image version (optional pin, default is :latest) -----------------
# SHELLIUS_VERSION=1.2.3
