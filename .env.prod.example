# =============================================================================
# Shellius — Production Environment Variables
# Copy this file to .env.prod, fill in all values, never commit .env.prod
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js
# -----------------------------------------------------------------------------
NODE_ENV=production

# Backend HTTP port (internal — not exposed to host in prod compose)
PORT=3001

# -----------------------------------------------------------------------------
# Database — PostgreSQL 16
# -----------------------------------------------------------------------------
# Individual parts used by the postgres service itself
POSTGRES_USER=shellius
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=shellius

# Full connection URL used by Prisma/backend (must match the values above)
DATABASE_URL=postgresql://shellius:CHANGE_ME_strong_postgres_password@postgres:5432/shellius?schema=public

# -----------------------------------------------------------------------------
# Cache / Queue — Redis 7
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# Full Redis URL used by the backend (must include the password above)
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379

# Split-form variables used by some config paths
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_value_from_jwt_secret

# -----------------------------------------------------------------------------
# Server Encryption Key (AES-256-GCM for CA private keys + cloud credentials)
# Generate with: openssl rand -hex 32  (must be exactly 32 hex-encoded bytes)
# -----------------------------------------------------------------------------
SERVER_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Bootstrap Agent
# -----------------------------------------------------------------------------
# Shared secret used by on-prem hosts to authenticate with the Shellius API
# Generate with: openssl rand -base64 32
AGENT_SHARED_SECRET=CHANGE_ME_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# Bootstrap super admin — read by `npx prisma db seed` on first install
# -----------------------------------------------------------------------------
# The seed script (backend/prisma/seed.js) reads these to create the
# initial organization + super admin. It is idempotent: rerunning the seed
# on a populated DB will NOT overwrite an existing super admin's password.
# To rotate the password explicitly: `npx prisma db seed -- --force-password`.
#
# All four marked REQUIRED must be set or the seed exits with an error.
SEED_ORG_NAME=Acme Corp                       # REQUIRED
SEED_ORG_SLUG=acme                            # REQUIRED — lowercase URL-safe
SEED_ORG_DOMAIN=acme.example.com              # optional
SEED_ADMIN_EMAIL=admin@acme.example.com       # REQUIRED
SEED_ADMIN_NAME=Super Admin                   # optional, default "Super Admin"
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password # REQUIRED

# -----------------------------------------------------------------------------
# Guacamole / RDP Gateway
# -----------------------------------------------------------------------------
GUACD_HOST=guacd
GUACD_PORT=4822

# -----------------------------------------------------------------------------
# Session Recordings
# -----------------------------------------------------------------------------
RECORDINGS_DIR=/data/recordings
# Number of days to retain recordings before automatic cleanup
RECORDING_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# CORS / Frontend
# -----------------------------------------------------------------------------
# The public URL of the frontend (used for CORS and email links)
CORS_ORIGIN=https://shellius.example.com
FRONTEND_URL=https://shellius.example.com

# The public hostname that Traefik/nginx routes point to
SHELLIUS_DOMAIN=shellius.example.com

# The public-facing API gateway host (used in bootstrap agent URLs, cert
# check-principals script, and device auth instructions)
PUBLIC_GATEWAY_HOST=shellius.example.com

# -----------------------------------------------------------------------------
# Prometheus Metrics (optional — /api/metrics endpoint)
# If set, the /api/metrics endpoint requires this token in the Authorization
# header as "Bearer <token>". Leave blank to disable the endpoint entirely.
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
METRICS_TOKEN=CHANGE_ME_or_leave_blank_to_disable_metrics

# -----------------------------------------------------------------------------
# SMTP — outgoing email defaults (Phase 16A)
# -----------------------------------------------------------------------------
# These act as DEFAULTS. A super_admin can override them per org via
# Settings → Notifications → SMTP. The UI override always wins.
# Leave everything blank to run in log-only mode (Shellius will log the
# would-be email body via the structured logger so an admin can copy the URL).
#
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxx
# SMTP_FROM=noreply@shellius.example.com
# SMTP_SECURE=true

# -----------------------------------------------------------------------------
# SSO — single sign-on credentials (Phase 16B)
# -----------------------------------------------------------------------------
# These act as DEFAULTS that pre-fill the Settings → SSO wizard. A super_admin
# can override them per org via the UI. The UI override always wins.
# Configure ONE preset block. The wizard shows a "Environment default" badge
# next to fields backed by an env var.

# Google Workspace
# SSO_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# SSO_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# Microsoft Entra ID (Azure AD)
# SSO_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# SSO_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SSO_ENTRA_CLIENT_SECRET=...

# Okta
# SSO_OKTA_DOMAIN=acme.okta.com
# SSO_OKTA_CLIENT_ID=...
# SSO_OKTA_CLIENT_SECRET=...

# Auth0
# SSO_AUTH0_DOMAIN=acme.auth0.com
# SSO_AUTH0_CLIENT_ID=...
# SSO_AUTH0_CLIENT_SECRET=...

# Generic OIDC (any compliant provider with discovery doc)
# SSO_ISSUER_URL=https://idp.example.com
# SSO_CLIENT_ID=...
# SSO_CLIENT_SECRET=...
