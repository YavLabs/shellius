# ============================================
# Shellius Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ---------- General ----------
NODE_ENV=development
PORT=3001

# ---------- Database ----------
DATABASE_URL=postgresql://shellius:shellius_dev@localhost:5433/shellius?schema=public
POSTGRES_USER=shellius
POSTGRES_PASSWORD=shellius_dev
POSTGRES_DB=shellius

# ---------- Redis ----------
REDIS_URL=redis://localhost:6380

# ---------- JWT ----------
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-hex-string
# 8h / 30d is the recommended default for self-hosted single-team deployments
# (no "session expired" prompts during the workday). Tighten to 15m / 7d if
# you're running a hosted multi-tenant instance — see .env.prod.example.
JWT_EXPIRY=8h
JWT_REFRESH_EXPIRY=30d

# ---------- Encryption ----------
# Used to encrypt CA private keys, cloud connector credentials, RDP passwords at rest
# Generate with: openssl rand -hex 32
SERVER_ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# ---------- SSH Host Agent ----------
# Shared secret used by target hosts to authenticate calls to POST /api/certificates/verify
# (check-principals agent). Generate with: openssl rand -hex 32
AGENT_SHARED_SECRET=change-me-to-a-random-64-char-hex-string

# ---------- Public URL ----------
# In production set TRAEFIK_HOST=shellius.example.com and the backend
# will derive CORS origin + frontend URL + SSO callback base from it.
# For local dev, leave it unset — the backend defaults to
# http://localhost:5173.
# TRAEFIK_HOST=

# Optional overrides (only if you really need something else):
# CORS_ORIGIN=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# PUBLIC_BASE_URL=http://localhost:3001

# ---------- Frontend ----------
VITE_API_URL=http://localhost:3001/api

# ---------- SSO (Optional) ----------
# SSO_PROVIDER=oidc
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_ISSUER_URL=
# SSO_CALLBACK_URL=http://localhost:3001/api/auth/sso/callback

# ---------- Cloud Connectors (Optional) ----------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=

# GCP_PROJECT_ID=
# GCP_SERVICE_ACCOUNT_KEY_PATH=

# ---------- Guacamole (Optional) ----------
# GUACAMOLE_URL=http://guacd:4822
# GUACAMOLE_ADMIN_USER=guacadmin
# GUACAMOLE_ADMIN_PASSWORD=guacadmin

# ---------- Session Recording ----------
RECORDING_RETENTION_DAYS=90

# ---------- MinIO (session recording storage) ----------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_RECORDINGS_BUCKET=shellius-recordings
