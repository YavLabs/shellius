# ============================================
# Shellius Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ---------- General ----------
NODE_ENV=development
PORT=3001

# ---------- Bundled infra profiles ----------
# Controls which bundled containers docker-compose starts. Default runs the
# full self-contained stack. To "bring your own" managed service, remove its
# profile here and point the matching env var at your external endpoint:
#   - drop "postgres" -> set DATABASE_URL to your managed Postgres
#   - drop "redis"    -> set REDIS_URL to your managed Redis
#   - drop "minio"    -> configure S3/Azure storage (env below or Settings UI)
COMPOSE_PROFILES=postgres,redis,minio

# ---------- Database ----------
# DATABASE_URL is bootstrap-critical (Prisma needs it before any app setting
# exists) so it is ENV-ONLY — it cannot be set from the Settings UI. To use an
# external Postgres, set this and remove "postgres" from COMPOSE_PROFILES.
DATABASE_URL=postgresql://shellius:shellius_dev@localhost:5433/shellius?schema=public
POSTGRES_USER=shellius
POSTGRES_PASSWORD=shellius_dev
POSTGRES_DB=shellius

# ---------- Redis ----------
# To use an external Redis, set REDIS_URL and remove "redis" from COMPOSE_PROFILES.
REDIS_URL=redis://localhost:6380

# ---------- JWT ----------
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-hex-string
# 8h / 30d is the recommended default for self-hosted single-team deployments
# (no "session expired" prompts during the workday). Tighten to 15m / 7d if
# you're running a hosted multi-tenant instance — see .env.prod.example.
JWT_EXPIRY=8h
JWT_REFRESH_EXPIRY=30d

# ---------- Encryption ----------
# Used to encrypt CA private keys, cloud connector credentials, RDP passwords at rest
# Generate with: openssl rand -hex 32
SERVER_ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# ---------- SSH Host Agent ----------
# Shared secret used by target hosts to authenticate calls to POST /api/certificates/verify
# (check-principals agent). Generate with: openssl rand -hex 32
AGENT_SHARED_SECRET=change-me-to-a-random-64-char-hex-string

# ---------- Public URL ----------
# In production set TRAEFIK_HOST=shellius.example.com and the backend
# will derive CORS origin + frontend URL + SSO callback base from it.
# For local dev, leave it unset — the backend defaults to
# http://localhost:5173.
# TRAEFIK_HOST=

# Optional overrides (only if you really need something else):
# CORS_ORIGIN=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# PUBLIC_BASE_URL=http://localhost:3001

# ---------- Frontend ----------
VITE_API_URL=http://localhost:3001/api

# White-label branding (optional). When set, the BrandLogo component
# replaces the default Terminal-icon mark and "Shellius" wordmark
# everywhere in the UI (sidebar, login, install page, etc.). Both
# logo URLs can be absolute (https://...) or root-relative (/brand.png)
# served from frontend/public/. The short variant is used in compact
# placements (sidebar collapsed, favicons in cards); when omitted the
# main URL is used in both spots.
# VITE_BRAND_NAME=Acme Access
# VITE_BRAND_LOGO_URL=/brand/acme-logo.svg
# VITE_BRAND_LOGO_SHORT_URL=/brand/acme-mark.svg

# ---------- SSO (Optional) ----------
# SSO_PROVIDER=oidc
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_ISSUER_URL=
# SSO_CALLBACK_URL=http://localhost:3001/api/auth/sso/callback

# ---------- Cloud Connectors (Optional) ----------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=

# GCP_PROJECT_ID=
# GCP_SERVICE_ACCOUNT_KEY_PATH=

# ---------- Guacamole (Optional) ----------
# GUACAMOLE_URL=http://guacd:4822
# GUACAMOLE_ADMIN_USER=guacadmin
# GUACAMOLE_ADMIN_PASSWORD=guacadmin

# ---------- MFA (two-factor auth) ----------
# Defaults; a super_admin can override per-org from Settings -> MFA.
# SSO logins rely on the identity provider's own MFA.
# MFA_ENABLED=false
# MFA_ENFORCED=false
# MFA_ALLOW_TOTP=true
# MFA_ALLOW_EMAIL_OTP=true
# MFA_ISSUER=Shellius

# ---------- Session Recording ----------
RECORDING_RETENTION_DAYS=90

# ---------- Object Storage (session recordings, uploads) ----------
# Storage is pluggable: MinIO (bundled), AWS S3, or Azure Blob. These env vars
# are the DEFAULT; a super_admin can override them at runtime from
# Settings -> Storage (stored in DB, no restart). DB config wins over env.
#
# STORAGE_PROVIDER selects the backend: minio | s3 | azure.
# (Left unset, a configured MINIO_ENDPOINT implies the "minio" provider for
#  backward compatibility.)
# STORAGE_PROVIDER=minio

# -- MinIO (self-hosted, S3-compatible) --
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_RECORDINGS_BUCKET=shellius-recordings

# -- AWS S3 (set STORAGE_PROVIDER=s3 and drop "minio" from COMPOSE_PROFILES) --
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=shellius-recordings
# STORAGE_ACCESS_KEY=            # falls back to AWS_ACCESS_KEY_ID
# STORAGE_SECRET_KEY=            # falls back to AWS_SECRET_ACCESS_KEY
# STORAGE_ENDPOINT=             # blank = AWS regional endpoint; set for S3-compatible

# -- Azure Blob (set STORAGE_PROVIDER=azure and drop "minio" from COMPOSE_PROFILES) --
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=shellius-recordings
# AZURE_BLOB_ENDPOINT=         # blank = https://<account>.blob.core.windows.net
