# ============================================
# Shellius Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ---------- General ----------
NODE_ENV=development
PORT=3001

# ---------- Bundled infra profiles ----------
# Controls which bundled containers docker-compose starts. Default runs the
# full self-contained stack. To "bring your own" managed service, remove its
# profile here and point the matching env var at your external endpoint:
#   - drop "postgres" -> set DATABASE_URL to your managed Postgres
#   - drop "redis"    -> set REDIS_URL to your managed Redis
#   - drop "minio"    -> configure S3/Azure storage (env below or Settings UI)
COMPOSE_PROFILES=postgres,redis,minio

# ---------- Database ----------
# DATABASE_URL is bootstrap-critical (Prisma needs it before any app setting
# exists) so it is ENV-ONLY — it cannot be set from the Settings UI. To use an
# external Postgres, set this and remove "postgres" from COMPOSE_PROFILES.
DATABASE_URL=postgresql://shellius:shellius_dev@localhost:5433/shellius?schema=public
POSTGRES_USER=shellius
POSTGRES_PASSWORD=shellius_dev
POSTGRES_DB=shellius

# ---------- Redis ----------
# To use an external Redis, set REDIS_URL and remove "redis" from COMPOSE_PROFILES.
REDIS_URL=redis://localhost:6380

# ---------- JWT ----------
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-hex-string
# 8h / 30d is the recommended default for self-hosted single-team deployments
# (no "session expired" prompts during the workday). Tighten to 15m / 7d if
# you're running a hosted multi-tenant instance — see .env.prod.example.
JWT_EXPIRY=8h
JWT_REFRESH_EXPIRY=30d

# ---------- Encryption ----------
# Used to encrypt CA private keys, cloud connector credentials, RDP passwords at rest
# Generate with: openssl rand -hex 32
SERVER_ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# ---------- SSH outbound target guard ----------
# All outbound SSH (web terminal, key deployment, credential test, Quick
# Connect, provisioning) refuses loopback / link-local / unspecified /
# multicast targets by default (see backend/src/services/sshConnect.js
# resolveTarget()). Local dev commonly runs throwaway SSH containers on
# 127.0.0.1 — set this to allow connecting to loopback targets ONLY. Never
# set this in production.
SSH_TARGET_ALLOW_LOOPBACK=false

# ---------- SSH Host Agent ----------
# Shared secret used by target hosts to authenticate calls to POST /api/certificates/verify
# (check-principals agent). Generate with: openssl rand -hex 32
AGENT_SHARED_SECRET=change-me-to-a-random-64-char-hex-string

# ---------- Public URL ----------
# In production set TRAEFIK_HOST=shellius.example.com and the backend
# will derive CORS origin + frontend URL + SSO callback base from it.
# For local dev, leave it unset — the backend defaults to
# http://localhost:5173.
# TRAEFIK_HOST=

# Optional overrides (only if you really need something else):
# CORS_ORIGIN=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# PUBLIC_BASE_URL=http://localhost:3001

# ---------- Frontend ----------
VITE_API_URL=http://localhost:3001/api

# White-label branding (optional). When set, the BrandLogo component
# replaces the default Terminal-icon mark and "Shellius" wordmark
# everywhere in the UI (sidebar, login, install page, etc.). Both
# logo URLs can be absolute (https://...) or root-relative (/brand.png)
# served from frontend/public/. The short variant is used in compact
# placements (sidebar collapsed, favicons in cards); when omitted the
# main URL is used in both spots.
# VITE_BRAND_NAME=Acme Access
# VITE_BRAND_LOGO_URL=/brand/acme-logo.svg
# VITE_BRAND_LOGO_SHORT_URL=/brand/acme-mark.svg

# ---------- SSO (Optional) ----------
# SSO_PROVIDER=oidc
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_ISSUER_URL=
# SSO_CALLBACK_URL=http://localhost:3001/api/auth/sso/callback

# ---------- Cloud Connectors (Optional) ----------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=

# GCP_PROJECT_ID=
# GCP_SERVICE_ACCOUNT_KEY_PATH=

# ---------- Guacamole (Optional) ----------
# GUACAMOLE_URL=http://guacd:4822
# GUACAMOLE_ADMIN_USER=guacadmin
# GUACAMOLE_ADMIN_PASSWORD=guacadmin

# ---------- MFA (two-factor auth) ----------
# Defaults; a super_admin can override per-org from Settings -> MFA.
# SSO logins rely on the identity provider's own MFA.
# MFA_ENABLED=false
# MFA_ENFORCED=false
# MFA_ALLOW_TOTP=true
# MFA_ALLOW_EMAIL_OTP=true
# MFA_ISSUER=Shellius

# ---------- Session Recording ----------
RECORDING_RETENTION_DAYS=90

# ---------- Object Storage (session recordings, uploads) ----------
# Storage is pluggable: MinIO (bundled), AWS S3, or Azure Blob. These env vars
# are the DEFAULT; a super_admin can override them at runtime from
# Settings -> Storage (stored in DB, no restart). DB config wins over env.
#
# STORAGE_PROVIDER selects the backend: minio | s3 | azure.
# (Left unset, a configured MINIO_ENDPOINT implies the "minio" provider for
#  backward compatibility.)
# STORAGE_PROVIDER=minio

# -- MinIO (self-hosted, S3-compatible) --
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_RECORDINGS_BUCKET=shellius-recordings

# -- AWS S3 (set STORAGE_PROVIDER=s3 and drop "minio" from COMPOSE_PROFILES) --
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=shellius-recordings
# STORAGE_ACCESS_KEY=            # falls back to AWS_ACCESS_KEY_ID
# STORAGE_SECRET_KEY=            # falls back to AWS_SECRET_ACCESS_KEY
# STORAGE_ENDPOINT=             # blank = AWS regional endpoint; set for S3-compatible

# -- Azure Blob (set STORAGE_PROVIDER=azure and drop "minio" from COMPOSE_PROFILES) --
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=shellius-recordings
# AZURE_BLOB_ENDPOINT=         # blank = https://<account>.blob.core.windows.net

# ---------- Local recording fallback ----------
# Used by the session-cleanup job / terminalService when no object storage
# provider is configured. Rarely needed once MinIO/S3/Azure is set up.
# RECORDINGS_DIR=./data/recordings

# ---------- Auth lockout ----------
# Failed local (email/password) logins lock the account for AUTH_LOCKOUT_MINUTES
# after AUTH_LOCKOUT_THRESHOLD consecutive failures. An admin can clear a lock
# early via POST /api/users/:id/unlock.
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_MINUTES=15

# ---------- Session hardening ----------
# Absolute lifetime of a refresh-token family (device/browser sign-in), in
# seconds. After this, the family is dead even if tokens keep rotating — the
# user must sign in again. Default 30d.
# SESSION_ABSOLUTE_TTL=2592000

# ---------- Terminal workspace ----------
# How long a detached (no browser tab attached) SSH session stays alive in the
# terminal hub before it's force-ended. Seconds. Default 900 (15 min).
# TERMINAL_DETACH_TTL_SECONDS=900

# ---------- Background job concurrency ----------
# BullMQ worker concurrency. Raise on beefier hosts, lower to reduce load on
# target hosts / the DB during large fleet operations.
# KEY_DEPLOYMENT_CONCURRENCY=5
# ONBOARDING_CONCURRENCY=5

# ---------- SSO — multi-provider env presets (optional) ----------
# Shellius supports multiple SSO providers per org, managed from Settings ->
# SSO (stored in the DB). These env vars are lightweight presets that appear
# as an additional login button without any DB row (until first use, when
# Google auto-materializes into an editable DB row) — handy for a single
# quick preset without touching the UI. Prefer the Settings UI for anything
# beyond one provider.
# SSO_ALLOWED_DOMAINS=example.com,example.org   # comma-separated; empty = any domain
# SSO_DEFAULT_ROLE=viewer                       # never allowed to be super_admin
# SSO_AUTO_PROVISION=true                       # JIT-create users on first SSO login
#
# -- Google (OIDC) --
# SSO_GOOGLE_CLIENT_ID=
# SSO_GOOGLE_CLIENT_SECRET=
#
# -- Microsoft Entra ID (OIDC) --
# SSO_ENTRA_TENANT_ID=
# SSO_ENTRA_CLIENT_ID=
# SSO_ENTRA_CLIENT_SECRET=
#
# -- Okta (OIDC) --
# SSO_OKTA_DOMAIN=your-org.okta.com
# SSO_OKTA_CLIENT_ID=
# SSO_OKTA_CLIENT_SECRET=
#
# -- Auth0 (OIDC) --
# SSO_AUTH0_DOMAIN=your-tenant.us.auth0.com
# SSO_AUTH0_CLIENT_ID=
# SSO_AUTH0_CLIENT_SECRET=
#
# -- GitHub (OAuth 2.0, incl. GitHub Enterprise Server) --
# Set SSO_ISSUER_URL to your GHES base URL (e.g. https://ghe.example.com) to
# use Enterprise Server instead of github.com; leave unset for github.com.
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=

# ---------- Reverse proxy / networking ----------
# Number of trusted reverse-proxy hops in front of the backend, for correct
# X-Forwarded-For handling (rate limiting, audit IPs). A number is safest
# (e.g. 1 for a single nginx/Traefik hop, 2 for proxy-manager -> Traefik).
# TRUST_PROXY=1

# Absolute URL overrides — normally derived from TRAEFIK_HOST. Set these
# instead if you're not using TRAEFIK_HOST (e.g. a custom reverse proxy setup
# or split public API / RDP gateway hostnames).
# APP_URL=https://shellius.example.com   # public URL of the web app: links in emails (invite, reset, approval), SSO redirect, CORS
# PUBLIC_API_URL=https://shellius.example.com/api
# RD_GATEWAY_HOST — a real Windows RD Gateway, for downloaded .rdp files only.
# Leave it unset unless you actually run one: the file then says "never use a
# gateway" and connects directly, which is what works. This replaces
# PUBLIC_GATEWAY_HOST, whose default of `localhost` told Windows to tunnel
# every connection through an RD Gateway on the user's own machine. The
# in-browser RDP session does not use this at all.
# RD_GATEWAY_HOST=rdgw.example.com

# ---------- Metrics ----------
# Enables GET /api/metrics (Prometheus text format). Leave unset to disable
# the endpoint entirely. Generate with: openssl rand -hex 16
# METRICS_TOKEN=

# ---------- Email (transactional) ----------
# Used for invites, password reset, access request notifications, cert expiry,
# account deletion, and email MFA codes. Email providers (SMTP, Google,
# Microsoft 365, SendGrid, Mailgun, Postmark, Resend) are configured per org in
# Settings -> Email (docs/email-delivery.md); these SMTP_* vars are only the
# fallback when an org has no active provider. Without either, Shellius logs
# the would-be email body instead of sending (useful for local dev).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=
# SMTP_FROM=noreply@shellius.example.com
# SMTP_FROM_NAME=Shellius
# SMTP_SECURITY=starttls        # none | starttls | tls (default: tls on 465, else STARTTLS if offered)
# SMTP_SECURE=true              # legacy, only read when SMTP_SECURITY is unset
# Email headers load the logo from $APP_URL/brand/png/…; with no public app
# URL (or localhost) they show a text wordmark instead.
