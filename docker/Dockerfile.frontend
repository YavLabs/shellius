FROM node:20-alpine AS builder

# APP_VERSION is not consumed directly here — the build reads the version
# from frontend/package.json (see vite.config.js `define: { __APP_VERSION__ }`),
# which CI keeps in sync with VERSION via `node scripts/version.mjs sync`
# before this build runs. GIT_SHA is threaded through as VITE_GIT_SHA so the
# footer can show a build fingerprint.
ARG APP_VERSION=0.0.0-dev
ARG GIT_SHA=unknown
ENV VITE_GIT_SHA=${GIT_SHA}

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

FROM nginx:alpine

ARG APP_VERSION=0.0.0-dev
ARG GIT_SHA=unknown

LABEL org.opencontainers.image.title="shellius-frontend" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.source="https://github.com/YavLabs/shellius"

RUN adduser -D -g '' appuser

COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Use 127.0.0.1 (not localhost): nginx listens on IPv4 0.0.0.0:80, but
# "localhost" resolves to IPv6 ::1 first inside the container, so the probe
# gets "connection refused" and the container is wrongly marked unhealthy.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
