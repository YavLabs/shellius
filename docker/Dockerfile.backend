FROM node:20-alpine AS builder

WORKDIR /app

COPY backend/package*.json ./
RUN npm ci

COPY backend/ .
# Include the CLI installer script so the backend can serve it from
# /api/cli/install.sh. See backend/src/routes/cli.js.
COPY scripts/install-tui.sh /app/scripts/install-tui.sh
RUN npx prisma generate

FROM node:20-alpine

# openssh-keygen → CA key generation + cert signing (caService.js shells out)
RUN apk add --no-cache openssh-keygen openssh-client && \
    addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src ./src
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/scripts ./scripts

# Entrypoint runs `prisma migrate deploy` then the idempotent seed
# (org, super admin, baseline groups + policies) before exec'ing the
# node server. The seed is soft-fail so missing SEED_* env vars don't
# block the API from coming up on existing deployments.
COPY docker/entrypoint-backend.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Pre-built TUI binaries served at /api/cli/bin/<name>. The tui-bin/
# directory is committed (with a .gitkeep sentinel) so the COPY
# always succeeds; populate it by running scripts/build-tui-binaries.sh
# on the host BEFORE `docker compose build backend`. Binaries are
# .gitignored inside tui-bin/ so we never commit compiled artifacts.
COPY tui-bin/ /app/tui-bin/

RUN mkdir -p /data/recordings && chown -R appuser:appgroup /data

USER appuser

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://localhost:3001/api/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
