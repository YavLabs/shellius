generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  super_admin
  admin
  manager
  member
}

/// How much of the org a user can see. ALL = today's behaviour (the whole
/// org); CUSTOMERS = only the customers resolved from UserCustomerScope +
/// the user's groups' GroupCustomerScope. See docs/rbac/customer-scope-spec.md.
enum AccessScope {
  ALL
  CUSTOMERS
}

enum UserStatus {
  active
  invited
  suspended
  deactivated
  pending_verification
  deleted
}

/// Whether a User row is a person or a machine identity.
///
/// Service accounts are real User rows so that everything built around a
/// user keeps working for them: AuditLog.actorId is an FK to User (a
/// synthetic id could not be attributed), roles and permissions resolve the
/// same way, customer scope applies, and a service account can be a policy
/// subject and actually connect to a server.
///
/// The cost is that every query meaning "people" must say so. Use the
/// HUMANS filter from userService rather than writing `kind` by hand.
enum UserKind {
  human
  service
}

enum DeviceAuthStatus {
  pending
  approved
  denied
  expired
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  settings  Json?
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                          User[]
  customers                      Customer[]
  servers                        Server[]
  auditLogs                      AuditLog[]
  groups                         Group[]
  ssoConfigs                     SsoConfig[]
  smtpConfig                     SmtpConfig?
  emailProviders                 EmailProvider[]
  deviceAuthRequests             DeviceAuthRequest[]
  caKeyPairs                     CaKeyPair[]
  certificates                   Certificate[]
  policies                       AccessPolicy[]
  accessRequests                 AccessRequest[]
  notifications                  Notification[]
  sessions                       Session[]
  sshKeys                        SshKey[]
  credentials                    Credential[]
  personalHosts                  PersonalHost[]
  keyDeployments                 KeyDeployment[]
  roles                          Role[]
  selfServiceRegistrationEnabled Boolean             @default(false) @map("self_service_registration_enabled")

  postureSnapshots  HostSnapshot[]
  postureListeners  HostListener[]
  postureServices   HostService[]
  postureFindings   ExposureFinding[]
  metricSamples     HostMetricSample[]
  expectedPorts     ServerExpectedPort[]
  postureAlertRules PostureAlertRule[]
  postureSettings   PostureSettings?
  apiTokens         ApiToken[]
  auditSinks        AuditSink[]

  @@map("organizations")
}

model User {
  id                String      @id @default(cuid())
  orgId             String      @map("org_id")
  email             String
  passwordHash      String?     @map("password_hash")
  name              String
  // Base tier of the user's role, kept in sync with assignedRole.baseRole.
  // Policies (ROLE subjects, approverRoles) and the CLI still read it; all
  // permission checks use assignedRole.permissions.
  role              OrgRole     @default(member)
  roleId            String?     @map("role_id")
  status            UserStatus  @default(active)
  // Person or machine. See the UserKind enum. A service account never signs
  // in: it holds no password, its email is unroutable, and it authenticates
  // only by API token.
  kind              UserKind    @default(human)
  // Service accounts only: what this identity is for.
  description       String?
  // Visibility scope. super_admin ignores this (they can edit their own).
  accessScope       AccessScope @default(ALL) @map("access_scope")
  managerId         String?     @map("manager_id")
  sshPublicKey      String?     @map("ssh_public_key") @db.Text
  ssoProvider       String?     @map("sso_provider")
  ssoSub            String?     @map("sso_sub")
  avatarUrl         String?     @map("avatar_url")
  preferences       Json        @default("{}") @map("preferences")
  lastLoginAt       DateTime?   @map("last_login_at")
  passwordChangedAt DateTime?   @map("password_changed_at")
  deletedAt         DateTime?   @map("deleted_at")
  jitUid            Int?        @map("jit_uid")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  organization        Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignedRole        Role?               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  manager             User?               @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  directReports       User[]              @relation("ManagerReports")
  refreshTokens       RefreshToken[]
  userTokens          UserToken[]
  identities          UserIdentity[]
  auditLogs           AuditLog[]
  groupMemberships    GroupMembership[]   @relation("GroupMemberships")
  customerScopes      UserCustomerScope[]
  groupsAddedBy       GroupMembership[]   @relation("GroupsAdded")
  deviceAuthRequests  DeviceAuthRequest[]
  certificatesIssued  Certificate[]       @relation("CertificatesIssuedTo")
  certificatesRevoked Certificate[]       @relation("CertificatesRevokedBy")
  // MFA (per-user). Disabled by default; enrollment is self-service.
  mfaTotpSecretEnc    String?             @map("mfa_totp_secret_enc") @db.Text // AES-256-GCM TOTP secret
  mfaTotpEnabled      Boolean             @default(false) @map("mfa_totp_enabled")
  mfaEmailEnabled     Boolean             @default(false) @map("mfa_email_enabled")
  mfaBackupCodes      String[]            @default([]) @map("mfa_backup_codes") // sha256 hashes
  mfaEnrolledAt       DateTime?           @map("mfa_enrolled_at")
  // Which factor sign-in asks for first when several are enrolled
  // ('totp' | 'email'); null = authenticator first. Ignored when that
  // factor isn't enabled.
  mfaPreferredMethod  String?             @map("mfa_preferred_method")
  // Unconfirmed TOTP secret during (re-)enrollment. Promoted to
  // mfaTotpSecretEnc only after the user proves possession, so starting a
  // re-enroll never invalidates a working authenticator.
  mfaTotpPendingEnc   String?             @map("mfa_totp_pending_enc") @db.Text
  // Brute-force protection: per-account lockout.
  failedLoginCount    Int                 @default(0) @map("failed_login_count")
  lastFailedLoginAt   DateTime?           @map("last_failed_login_at")
  lockedUntil         DateTime?           @map("locked_until")
  // Access tokens issued (iat) before this instant are rejected. Bumped on
  // password change/reset, role change, suspension and "sign out everywhere".
  sessionsValidFrom   DateTime?           @map("sessions_valid_from")

  accessRequestsRequested AccessRequest[]         @relation("AccessRequestsRequested")
  accessRequestsToReview  AccessRequest[]         @relation("AccessRequestsToReview")
  accessRequestApprovals  AccessRequestApprover[]
  notifications           Notification[]
  sessions                Session[]
  // Personal vault (docs/personal-vault.md) — private to this user.
  personalSshKeys         SshKey[]                @relation("PersonalSshKeys")
  personalCredentials     Credential[]            @relation("PersonalCredentials")
  personalHosts           PersonalHost[]
  apiTokens               ApiToken[]              @relation("ApiTokensForUser")
  apiTokensIssued         ApiToken[]              @relation("ApiTokensIssuedBy")
  apiTokensRevoked        ApiToken[]              @relation("ApiTokensRevokedBy")

  @@unique([orgId, email])
  @@unique([orgId, jitUid], map: "user_org_jit_uid_unique")
  @@index([orgId])
  @@index([managerId])
  @@index([roleId])
  @@index([orgId, kind])
  @@map("users")
}

// A named set of permissions (keys from src/config/permissions.js). Every org
// has four system roles (super_admin, admin, manager, member — key == tier)
// plus any custom roles. super_admin always holds every permission.
model Role {
  id             String   @id @default(cuid())
  orgId          String   @map("org_id")
  key            String
  name           String
  description    String?
  baseRole       OrgRole  @map("base_role")
  permissions    String[] @default([])
  isSystem       Boolean  @default(false) @map("is_system")
  catalogVersion Int      @default(0) @map("catalog_version")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([orgId, key])
  @@unique([orgId, name])
  @@index([orgId])
  @@map("roles")
}

model Customer {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  name        String
  slug        String
  description String?
  metadata    Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  servers      Server[]
  policies     AccessPolicy[]
  userScopes   UserCustomerScope[]
  groupScopes  GroupCustomerScope[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("customers")
}

enum Environment {
  demo
  dev
  staging
  prod
}

enum ServerProtocol {
  ssh
  rdp
  both
}

enum ServerAuthMode {
  certificate
  credential
}

enum HealthStatus {
  healthy
  unhealthy
  unknown
  maintenance
}

model Server {
  id                   String         @id @default(cuid())
  orgId                String         @map("org_id")
  customerId           String         @map("customer_id")
  hostname             String
  displayName          String?        @map("display_name")
  description          String?
  ipAddress            String         @map("ip_address")
  dynamicIp            Boolean        @default(false) @map("dynamic_ip") // public IP can change (no static IP)
  port                 Int            @default(22)
  protocol             ServerProtocol @default(ssh)
  environment          Environment    @default(dev)
  labels               Json           @default("[]")
  osType               String?        @map("os_type")
  osVersion            String?        @map("os_version")
  cloudProvider        String?        @map("cloud_provider")
  cloudInstanceId      String?        @unique @map("cloud_instance_id")
  cloudRegion          String?        @map("cloud_region")
  cloudAccountId       String?        @map("cloud_account_id")
  agentId              String?        @unique @map("agent_id")
  agentVersion         String?        @map("agent_version")
  agentLastSeen        DateTime?      @map("agent_last_seen")
  // Per-host agent credential (check-principals + heartbeat). Only the
  // SHA-256 hash is stored; the token is written to the host at bootstrap.
  // Replaces the single global AGENT_SHARED_SECRET, and lets
  // /api/certificates/verify bind a certificate to the host asking.
  agentTokenHash       String?        @unique @map("agent_token_hash")
  agentTokenIssuedAt   DateTime?      @map("agent_token_issued_at")
  agentTokenLastUsedAt DateTime?      @map("agent_token_last_used_at")
  healthStatus         HealthStatus   @default(unknown) @map("health_status")
  lastHealthCheck      DateTime?      @map("last_health_check")
  healthMessage        String?        @map("health_message")
  sshUser              String         @default("root") @map("ssh_user")
  sshKeyPath           String?        @map("ssh_key_path")
  rdpUsername          String?        @map("rdp_username")
  rdpPasswordEncrypted String?        @map("rdp_password_encrypted")
  rdpPasswordIv        String?        @map("rdp_password_iv")
  rdpPasswordTag       String?        @map("rdp_password_tag")
  // How Shellius authenticates to this host. certificate = short-lived cert
  // signed by the org CA (host must be bootstrapped). credential = a stored
  // Keystore identity (password and/or private key) — no bootstrap needed.
  authMode             ServerAuthMode @default(certificate) @map("auth_mode")
  credentialId         String?        @map("credential_id")
  // Pinned SSH host key (TOFU on first ssh2 connect; mismatch = refuse).
  hostKeyFingerprint   String?        @map("host_key_fingerprint") // SHA256:...
  hostKeyAlgorithm     String?        @map("host_key_algorithm")
  hostKeyPinnedAt      DateTime?      @map("host_key_pinned_at")
  isActive             Boolean        @default(true) @map("is_active")
  // Onboarding / provisioning state. provisionStatus tracks where the server
  // is in the bootstrap lifecycle so the UI can show progress and bulk-import
  // can detect already-onboarded hosts for idempotent re-onboarding.
  // Values: pending | provisioning | provisioned | failed
  provisionStatus      String         @default("pending") @map("provision_status")
  provisionError       String?        @map("provision_error")
  provisionedAt        DateTime?      @map("provisioned_at")
  lastProvisionAt      DateTime?      @map("last_provision_at")
  // Keystore identity whose password is this host's sudo password, so a
  // reinstall over a certificate (which has no password of its own) does
  // not stop and ask again. Org-scoped only; never a personal vault item.
  sudoCredentialId     String?        @map("sudo_credential_id")
  // The newest posture snapshot this host sent that the API refused, and
  // why. A host whose snapshots are all rejected looks exactly like one
  // whose collector died — this is what tells the two apart. Cleared by the
  // next accepted snapshot.
  postureRejectedAt    DateTime?      @map("posture_rejected_at")
  postureRejectReason  String?        @map("posture_reject_reason")
  // When Shellius last installed the collector here successfully. A report
  // older than this came from the collector that was replaced, so the page
  // says "waiting for the first report" instead of showing its warnings.
  postureInstalledAt   DateTime?      @map("posture_installed_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  organization     Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  credential       Credential?          @relation("ServerCredential", fields: [credentialId], references: [id], onDelete: SetNull)
  sudoCredential   Credential?          @relation("ServerSudoCredential", fields: [sudoCredentialId], references: [id], onDelete: SetNull)
  keyDeployments   KeyDeployment[]
  certificates     Certificate[]
  accessRequests   AccessRequest[]
  sessions         Session[]
  postureSnapshots HostSnapshot[]
  postureListeners HostListener[]
  postureServices  HostService[]
  postureFindings  ExposureFinding[]
  metricSamples    HostMetricSample[]
  expectedPorts    ServerExpectedPort[]

  @@index([orgId, customerId])
  @@index([orgId, environment])
  @@index([healthStatus])
  @@index([agentId])
  @@index([orgId, provisionStatus])
  @@index([credentialId])
  @@index([sudoCredentialId])
  @@map("servers")
}

model RefreshToken {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  tokenHash        String    @unique @map("token_hash")
  clientType       String    @default("web") @map("client_type")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  // Rotation family: every refresh token minted from one sign-in shares a
  // familyId. Reuse of a rotated token revokes the whole family only.
  familyId         String?   @map("family_id")
  // When the family (sign-in) started — enforces an absolute session lifetime.
  sessionStartedAt DateTime  @default(now()) @map("session_started_at")
  lastUsedAt       DateTime? @map("last_used_at")
  // Set when rotated/revoked; row kept briefly for reuse detection.
  revokedAt        DateTime? @map("revoked_at")
  replacedById     String?   @map("replaced_by_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  actorId      String?  @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([actorId])
  // (orgId, createdAt, id) is a total order, so a sequential reader's
  // keyset predicate uses this index directly instead of sorting.
  @@index([orgId, createdAt, id])
  // A sink that only wants some actions, and the existing facets() query.
  @@index([orgId, action])
  @@index([orgId, resourceType])
  @@map("audit_logs")
}

model Group {
  id          String      @id @default(cuid())
  orgId       String      @map("org_id")
  name        String
  description String?
  // How much of the org every CUSTOMERS-scoped member sees while in this
  // group. Default CUSTOMERS (NOT User's ALL default) so an existing group
  // contributes nothing until someone deliberately widens it — additive,
  // empty = no-op. ALL is a deliberate widening path: a CUSTOMERS member of
  // an ALL group becomes effectively unscoped (lib/scope.js resolveScope).
  // See docs/rbac/customer-scope-spec.md.
  accessScope AccessScope @default(CUSTOMERS) @map("access_scope")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  organization   Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships    GroupMembership[]
  customerScopes GroupCustomerScope[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("groups")
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  addedById String?  @map("added_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User  @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User? @relation("GroupsAdded", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_memberships")
}

/// Customers a user may see when User.accessScope = CUSTOMERS. Additive with
/// the scopes of any group they belong to.
model UserCustomerScope {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  customerId String   @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([userId, customerId])
  @@index([userId])
  @@index([customerId])
  @@map("user_customer_scopes")
}

/// Customers every member of a group may see. Only consulted for users whose
/// accessScope is CUSTOMERS — joining a scoped group never narrows an
/// unscoped user.
model GroupCustomerScope {
  id         String   @id @default(cuid())
  groupId    String   @map("group_id")
  customerId String   @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([groupId, customerId])
  @@index([groupId])
  @@index([customerId])
  @@map("group_customer_scopes")
}

/// One SSO identity provider for an org. An org may enable several at once
/// (e.g. Google + GitHub + Entra); each renders its own sign-in button.
model SsoConfig {
  id                    String   @id @default(cuid())
  orgId                 String   @map("org_id")
  // oidc | github (github = OAuth 2.0, not OIDC — fixed endpoints, /user/emails)
  provider              String
  presetId              String?  @map("preset_id") // google | entra | okta | auth0 | generic | github
  // Button label on the login page, e.g. "Google" or "Acme Okta".
  name                  String   @default("Single Sign-On")
  displayOrder          Int      @default(0) @map("display_order")
  clientId              String   @map("client_id")
  // Nullable: env-preset configs (e.g. SSO_GOOGLE_CLIENT_SECRET) supply the
  // secret, so a row can manage defaultRole/autoProvision without storing it.
  clientSecretEncrypted String?  @map("client_secret_encrypted") @db.Text
  issuerUrl             String   @map("issuer_url")
  redirectUri           String   @map("redirect_uri")
  scopes                String   @default("openid profile email")
  // New-user provisioning policy for SSO sign-ins.
  defaultRole           String   @default("member") @map("default_role")
  defaultGroupId        String?  @map("default_group_id")
  autoProvision         Boolean  @default(true) @map("auto_provision")
  // Email domains allowed to sign in / be provisioned via SSO. Empty = any.
  allowedDomains        String[] @default([]) @map("allowed_domains")
  // Only link an SSO identity to an existing account by email when the IdP
  // asserts email_verified.
  requireVerifiedEmail  Boolean  @default(true) @map("require_verified_email")
  // GitHub only: restrict sign-in to members of these GitHub organizations
  // (requires the read:org scope). Empty = any GitHub account.
  allowedOrgs           String[] @default([]) @map("allowed_orgs")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  identities   UserIdentity[]

  @@index([orgId])
  @@map("sso_configs")
}

/// A user's linked external identity (one per SSO provider). Replaces the
/// single User.ssoProvider/ssoSub pair, which is kept only for legacy reads.
model UserIdentity {
  id          String    @id @default(cuid())
  orgId       String    @map("org_id")
  userId      String    @map("user_id")
  ssoConfigId String    @map("sso_config_id")
  provider    String // oidc | github (denormalised from SsoConfig)
  subject     String // OIDC sub / GitHub numeric user id
  email       String?
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ssoConfig SsoConfig @relation(fields: [ssoConfigId], references: [id], onDelete: Cascade)

  @@unique([ssoConfigId, subject])
  @@index([userId])
  @@index([orgId])
  @@map("user_identities")
}

model DeviceAuthRequest {
  id         String           @id @default(cuid())
  deviceCode String           @unique @map("device_code")
  userCode   String           @unique @map("user_code")
  clientId   String           @map("client_id")
  scope      String           @default("")
  orgId      String           @map("org_id")
  userId     String?          @map("user_id")
  status     DeviceAuthStatus @default(pending)
  interval   Int              @default(5)
  expiresAt  DateTime         @map("expires_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  lastPollAt DateTime?        @map("last_poll_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userCode])
  @@index([status, expiresAt])
  @@map("device_auth_requests")
}

enum CertType {
  USER
  HOST
}

enum CertStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model CaKeyPair {
  id                  String    @id @default(cuid())
  orgId               String    @map("org_id")
  name                String
  algorithm           String    @default("Ed25519")
  publicKey           String    @map("public_key") @db.Text
  encryptedPrivateKey String    @map("encrypted_private_key") @db.Text
  encryptionIv        String    @map("encryption_iv")
  encryptionTag       String    @map("encryption_tag")
  fingerprint         String    @unique
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  rotatedAt           DateTime? @map("rotated_at")
  expiresAt           DateTime? @map("expires_at")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  certificates Certificate[]

  @@index([orgId, isActive])
  @@map("ca_key_pairs")
}

model Certificate {
  id              String     @id @default(cuid())
  orgId           String     @map("org_id")
  caKeyPairId     String     @map("ca_key_pair_id")
  serial          BigInt     @unique
  type            CertType
  keyId           String     @map("key_id")
  principals      String[]
  publicKey       String     @map("public_key") @db.Text
  signedCert      String     @map("signed_cert") @db.Text
  validAfter      DateTime   @map("valid_after")
  validBefore     DateTime   @map("valid_before")
  extensions      Json?
  criticalOptions Json?      @map("critical_options")
  status          CertStatus @default(ACTIVE)
  issuedToId      String?    @map("issued_to_id")
  issuedForId     String?    @map("issued_for_id")
  revokedAt       DateTime?  @map("revoked_at")
  revokedById     String?    @map("revoked_by_id")
  issuedVia       String     @default("web") @map("issued_via")
  createdAt       DateTime   @default(now()) @map("created_at")

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  caKeyPair      CaKeyPair       @relation(fields: [caKeyPairId], references: [id], onDelete: Cascade)
  issuedTo       User?           @relation("CertificatesIssuedTo", fields: [issuedToId], references: [id], onDelete: SetNull)
  issuedFor      Server?         @relation(fields: [issuedForId], references: [id], onDelete: SetNull)
  revokedBy      User?           @relation("CertificatesRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  accessRequests AccessRequest[]
  sessions       Session[]

  @@index([orgId, status])
  @@index([orgId, validBefore])
  @@index([issuedToId])
  @@index([issuedForId])
  @@index([caKeyPairId])
  @@map("certificates")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  REVOKED
}

enum Protocol {
  SSH
  RDP
}

enum NotificationType {
  ACCESS_REQUEST_SUBMITTED
  ACCESS_REQUEST_APPROVED
  ACCESS_REQUEST_DENIED
  ACCESS_REQUEST_EXPIRING
  ACCESS_REQUEST_EXPIRED
  ACCESS_REQUEST_REVOKED
  BREAK_GLASS_INVOKED
  POSTURE_FINDING
}

enum PolicyEffect {
  ALLOW
  DENY
}

enum SubjectType {
  USER
  GROUP
  ROLE
}

model AccessPolicy {
  id                 String       @id @default(cuid())
  orgId              String       @map("org_id")
  customerId         String?      @map("customer_id")
  name               String
  description        String?
  effect             PolicyEffect
  targetEnvironments String[]     @map("target_environments")
  targetLabels       Json         @default("{}") @map("target_labels")
  targetServerIds    String[]     @map("target_server_ids")
  allowedPrincipals  String[]     @map("allowed_principals")
  maxSessionDuration Int          @map("max_session_duration")
  requireApproval    Boolean      @default(false) @map("require_approval")
  autoApprove        Boolean      @default(false) @map("auto_approve")
  isActive           Boolean      @default(true) @map("is_active")
  priority           Int          @default(100)
  osProvisioning     Json         @default("{}") @map("os_provisioning")
  allowKeyDownload   Boolean      @default(false) @map("allow_key_download")
  isBreakGlass       Boolean      @default(false) @map("is_break_glass")
  // Approver routing: when a request matched by this policy needs approval,
  // these define WHO may approve. Empty across all three = fall back to the
  // requester's manager (legacy behaviour). Any one resolved approver can act.
  approverGroupId    String?      @map("approver_group_id")
  approverRoles      String[]     @default([]) @map("approver_roles") // OrgRole values
  approverUserIds    String[]     @default([]) @map("approver_user_ids")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subjects     PolicySubject[]

  @@index([orgId, isActive])
  @@index([customerId])
  @@index([effect, priority])
  @@map("access_policies")
}

model PolicySubject {
  id          String      @id @default(cuid())
  policyId    String      @map("policy_id")
  subjectType SubjectType @map("subject_type")
  subjectId   String      @map("subject_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  policy AccessPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, subjectType, subjectId])
  @@index([subjectType, subjectId])
  @@map("policy_subjects")
}

model AccessRequest {
  id                 String              @id @default(cuid())
  orgId              String              @map("org_id")
  requesterId        String              @map("requester_id")
  reviewerId         String?             @map("reviewer_id")
  serverId           String              @map("server_id")
  status             AccessRequestStatus @default(PENDING) @map("status")
  reason             String
  requestedPrincipal String              @map("requested_principal")
  requestedDuration  Int                 @map("requested_duration")
  protocol           Protocol            @default(SSH)
  approvedDuration   Int?                @map("approved_duration")
  approvedAt         DateTime?           @map("approved_at")
  deniedAt           DateTime?           @map("denied_at")
  deniedReason       String?             @map("denied_reason")
  expiresAt          DateTime?           @map("expires_at")
  revokedAt          DateTime?           @map("revoked_at")
  revokedReason      String?             @map("revoked_reason")
  certificateId      String?             @map("certificate_id")
  breakGlass         Boolean             @default(false) @map("break_glass")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requester    User                    @relation("AccessRequestsRequested", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer     User?                   @relation("AccessRequestsToReview", fields: [reviewerId], references: [id], onDelete: SetNull)
  server       Server                  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  certificate  Certificate?            @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  sessions     Session[]
  approvers    AccessRequestApprover[]

  @@index([requesterId])
  @@index([reviewerId, status])
  @@index([serverId])
  @@index([status, expiresAt])
  @@index([orgId])
  @@map("access_requests")
}

/// The set of users eligible to approve a pending AccessRequest. Populated at
/// submit() time from the matched policy's approver routing (group / roles /
/// users) or the requester's manager. Any one of them may approve or deny.
model AccessRequestApprover {
  id        String   @id @default(cuid())
  requestId String   @map("request_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  request AccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([userId])
  @@map("access_request_approvers")
}

enum SessionType {
  SSH
  RDP
}

enum SessionStatus {
  ACTIVE
  ENDED
  TERMINATED
}

model Session {
  id              String        @id @default(cuid())
  orgId           String        @map("org_id")
  userId          String        @map("user_id")
  // Null for Quick Connect sessions to hosts that are not saved servers.
  serverId        String?       @map("server_id")
  certificateId   String?       @map("certificate_id")
  accessRequestId String?       @map("access_request_id")
  sessionType     SessionType   @map("session_type")
  // certificate | credential | quick_connect
  authMethod      String        @default("certificate") @map("auth_method")
  targetHost      String?       @map("target_host")
  targetPort      Int?          @map("target_port")
  targetUser      String?       @map("target_user")
  status          SessionStatus @default(ACTIVE)
  clientIp        String?       @map("client_ip")
  userAgent       String?       @map("user_agent")
  startedAt       DateTime      @default(now()) @map("started_at")
  endedAt         DateTime?     @map("ended_at")
  durationSeconds Int?          @map("duration_seconds")
  recordingPath   String?       @map("recording_path")
  recordingKey    String?       @map("recording_key")
  metadata        Json?

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  server        Server?        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  certificate   Certificate?   @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  accessRequest AccessRequest? @relation(fields: [accessRequestId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([userId])
  @@index([serverId])
  @@index([accessRequestId])
  @@map("sessions")
}

model Notification {
  id        String           @id @default(cuid())
  orgId     String           @map("org_id")
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  metadata  Json             @default("{}") @map("metadata")
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([orgId])
  @@map("notifications")
}

/// Somewhere an organization's audit log is copied to, so it can live in the
/// SIEM or object store their security team already watches.
///
/// Shaped like EmailProvider on purpose: one row per destination, every
/// type-specific setting (secrets included) in a single AES-256-GCM blob
/// that the API never returns, and a test button. Unlike EmailProvider there
/// is no one-active-per-org rule — an org may stream to several at once.
model AuditSink {
  id              String  @id @default(cuid())
  orgId           String  @map("org_id")
  name            String
  type            String // webhook | s3 | syslog | email_digest
  configEncrypted String? @map("config_encrypted") @db.Text
  /// Optional narrowing: { actions: [], resourceTypes: [] }. Empty = all.
  filters         Json?
  isActive        Boolean @default(false) @map("is_active")
  batchSize       Int     @default(500) @map("batch_size")

  // Durable cursor into audit_logs, ordered by (created_at, id). Streaming
  // sinks only — a digest works on a time window instead.
  cursorCreatedAt DateTime? @map("cursor_created_at")
  cursorId        String?   @map("cursor_id")

  lastRunAt           DateTime? @map("last_run_at")
  lastOkAt            DateTime? @map("last_ok_at")
  lastError           String?   @map("last_error") @db.Text
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  backoffUntil        DateTime? @map("backoff_until")
  /// Set when the worker gives up, so the UI can say why it stopped rather
  /// than just showing it as off.
  disabledReason      String?   @map("disabled_reason")

  lastTestAt    DateTime? @map("last_test_at")
  lastTestOk    Boolean?  @map("last_test_ok")
  lastTestError String?   @map("last_test_error") @db.Text

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries   AuditSinkDelivery[]

  @@index([orgId])
  @@index([isActive, backoffUntil])
  @@map("audit_sinks")
}

/// One attempted batch, so an operator can answer "did those entries ship?"
/// without reading the destination. Pruned by the archive job.
model AuditSinkDelivery {
  id            String    @id @default(cuid())
  sinkId        String    @map("sink_id")
  orgId         String    @map("org_id")
  /// Derived from the row range, so a retry of the same batch reuses it —
  /// the receiver's idempotency key, since delivery is at-least-once.
  batchId       String    @map("batch_id")
  fromCreatedAt DateTime  @map("from_created_at")
  toCreatedAt   DateTime  @map("to_created_at")
  firstLogId    String    @map("first_log_id")
  lastLogId     String    @map("last_log_id")
  count         Int
  status        String // ok | failed
  attempt       Int       @default(1)
  objectKey     String?   @map("object_key") // s3 only
  error         String?   @db.Text
  durationMs    Int?      @map("duration_ms")
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  sink AuditSink @relation(fields: [sinkId], references: [id], onDelete: Cascade)

  @@index([sinkId, startedAt])
  @@index([orgId, startedAt])
  @@map("audit_sink_deliveries")
}

/// A long-lived bearer credential for non-interactive callers. Two kinds,
/// one model, one auth path (middleware/apiTokenAuth.js):
///
///   personal — minted by a person for their own scripts. Its permissions
///              are ALWAYS intersected with the owner's live role on every
///              request, so it can narrow but never grant, and a demotion
///              takes effect on the next call without re-minting.
///   service  — belongs to a User row with kind = 'service': a non-login
///              identity with its own Role, owned by the org rather than by
///              a person, so it survives them leaving.
///
/// Only the SHA-256 hash is stored — the plaintext is returned exactly once,
/// on create and on rotate, and never logged.
model ApiToken {
  id            String    @id @default(cuid())
  orgId         String    @map("org_id")
  // The identity this token acts as: its owner (personal) or the service
  // account itself (service).
  userId        String    @map("user_id")
  kind          String // personal | service
  name          String
  description   String?
  tokenHash     String    @unique @map("token_hash") // sha256 hex
  // First few characters of the plaintext, for telling tokens apart in the
  // UI. Not a secret and not enough to authenticate with.
  tokenPrefix   String    @map("token_prefix")
  /// Permission keys this token may use. EMPTY means "whatever its user's
  /// role allows". Always intersected with that live set at request time.
  scopes        String[]  @default([])
  expiresAt     DateTime  @map("expires_at")
  lastUsedAt    DateTime? @map("last_used_at")
  lastUsedIp    String?   @map("last_used_ip")
  revokedAt     DateTime? @map("revoked_at")
  revokedById   String?   @map("revoked_by_id")
  revokedReason String?   @map("revoked_reason")
  rotatedAt     DateTime? @map("rotated_at")
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation("ApiTokensForUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ApiTokensIssuedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy    User?        @relation("ApiTokensRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([orgId, kind])
  @@index([userId])
  @@index([expiresAt])
  @@map("api_tokens")
}

model UserToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  type       String
  tokenHash  String    @unique @map("token_hash")
  // Optional binding to a domain object (e.g. the AccessRequest an approval
  // token is for). Null for plain invite / password-reset tokens.
  resourceId String?   @map("resource_id")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_tokens")
}

model SmtpConfig {
  id                String   @id @default(cuid())
  orgId             String   @unique @map("org_id")
  host              String
  port              Int      @default(587)
  username          String?
  passwordEncrypted String?  @map("password_encrypted") @db.Text
  fromAddress       String?  @map("from_address")
  useTls            Boolean  @default(true) @map("use_tls")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("smtp_configs")
}

/// Outbound email delivery provider (docs/email-delivery.md). An org may
/// define several; at most ONE is active (partial unique index
/// email_providers_one_active_per_org, created in the migration SQL — Prisma
/// can't express partial indexes — plus a transaction in
/// emailProviderService.activate()). All type-specific settings, secrets
/// included, live in configEncrypted as one AES-256-GCM encrypted JSON blob
/// and are never returned by the API. No active provider → SMTP_* env vars
/// → log-only.
///
/// legacySmtpConfigId: set on rows the 20260921000000_email_providers
/// migration copied from smtp_configs. SQL can't encrypt, so those rows start
/// with configEncrypted NULL and emailProviderService imports the legacy row
/// (decrypting its password) on boot / first use. smtp_configs is kept
/// untouched for rollback.
model EmailProvider {
  id                 String    @id @default(cuid())
  orgId              String    @map("org_id")
  name               String
  type               String // smtp | google | microsoft | sendgrid | mailgun | postmark | resend
  fromAddress        String?   @map("from_address")
  fromName           String?   @map("from_name")
  configEncrypted    String?   @map("config_encrypted") @db.Text
  isActive           Boolean   @default(false) @map("is_active")
  lastTestAt         DateTime? @map("last_test_at")
  lastTestOk         Boolean?  @map("last_test_ok")
  lastTestError      String?   @map("last_test_error") @db.Text
  legacySmtpConfigId String?   @map("legacy_smtp_config_id")
  createdById        String?   @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("email_providers")
}

/// Per-org MFA policy. enabled = MFA available; enforced = all users must
/// enroll. Methods toggle which factors are offered. Overrides env defaults.
model MfaConfig {
  id            String   @id @default(cuid())
  orgId         String   @unique @map("org_id")
  enabled       Boolean  @default(false)
  enforced      Boolean  @default(false)
  allowTotp     Boolean  @default(true) @map("allow_totp")
  allowEmailOtp Boolean  @default(true) @map("allow_email_otp")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("mfa_configs")
}

/// Bulk-import staging: one upload (csv/json/zip). Drives the preview →
/// conflict-resolution → commit → onboarding pipeline.
model ImportJob {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  actorId   String?  @map("actor_id")
  // uploaded | preview_ready | committing | onboarding | completed | failed
  status    String   @default("preview_ready")
  source    String   @default("csv") // csv | json | zip
  summary   Json     @default("{}") // per-entity create/update/skip/conflict/error counts
  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rows        ImportRow[]
  credentials OnboardingCredential[]

  @@index([orgId, status])
  @@map("import_jobs")
}

/// One parsed record in an import. Holds the raw + resolved data, the planned
/// action, the user's conflict decision, and the outcome.
model ImportRow {
  id             String  @id @default(cuid())
  jobId          String  @map("job_id")
  entity         String // customer | server | user | group | policy | membership
  rowIndex       Int     @map("row_index")
  raw            Json
  resolved       Json    @default("{}")
  action         String  @default("create") // create | update | skip | conflict | error
  decision       String? // overwrite | skip (user choice for conflicts)
  conflictReason String? @map("conflict_reason")
  status         String  @default("pending") // pending | imported | skipped | failed
  error          String?
  resultId       String? @map("result_id")

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, entity])
  @@map("import_rows")
}

/// Ephemeral, AES-256-GCM-encrypted bootstrap credentials for background server
/// onboarding. Hard-deleted by the onboarding worker on completion and by a TTL
/// reaper. Documented exception to the "never store keys" rule, scoped to an
/// active import job.
model OnboardingCredential {
  id                    String   @id @default(cuid())
  jobId                 String   @map("job_id")
  serverRef             String   @map("server_ref") // hostname used to match the server row
  serverId              String?  @map("server_id")
  sshUser               String?  @map("ssh_user")
  authMethod            String   @map("auth_method") // password | key | key+password
  secretEncrypted       String?  @map("secret_encrypted") @db.Text // encrypted private key (legacy: or password)
  passwordEncrypted     String?  @map("password_encrypted") @db.Text // encrypted SSH login password
  passphraseEncrypted   String?  @map("passphrase_encrypted") @db.Text // encrypted private-key passphrase
  sudoPasswordEncrypted String?  @map("sudo_password_encrypted") @db.Text
  status                String   @default("pending") // pending | running | done | failed
  attempts              Int      @default(0)
  // Opt-in: keep this secret in the org Keystore as a reusable identity and
  // bind it to the server, instead of wiping it once onboarding finishes.
  // Without it an import leaves every host it just bootstrapped with nothing
  // stored — which is precisely the "no credentials" population the bulk
  // installer then has to skip.
  storeAsIdentity       Boolean  @default(false) @map("store_as_identity")
  // Name of the Keystore identity to create or reuse. Rows sharing a name
  // collapse into ONE identity, so fifty hosts behind one bastion key do not
  // become fifty Keystore entries.
  identityName          String?  @map("identity_name")
  expiresAt             DateTime @map("expires_at")
  createdAt             DateTime @default(now()) @map("created_at")

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([expiresAt])
  @@map("onboarding_credentials")
}

/// Application-wide object storage configuration (MinIO / AWS S3 / Azure Blob).
/// Global singleton (scope = "global") rather than per-org: object storage is
/// configured once by a super_admin and is used at boot (ensureBucket) where no
/// org context exists. DB row overrides env vars; absence falls back to env.
model StorageConfig {
  id                 String   @id @default(cuid())
  scope              String   @unique @default("global")
  provider           String   @default("minio") // minio | s3 | azure
  endpoint           String? // full URL or bare host (minio/custom s3); blank = AWS regional / Azure default
  region             String? // s3 region
  bucket             String? // bucket name (s3/minio) or container name (azure)
  accessKey          String?  @map("access_key") // access key id (s3/minio) or account name (azure) — not secret
  secretKeyEncrypted String?  @map("secret_key_encrypted") @db.Text // AES-256-GCM
  useSsl             Boolean  @default(false) @map("use_ssl")
  forcePathStyle     Boolean  @default(true) @map("force_path_style") // true for minio-style path addressing
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("storage_configs")
}

// ---------------------------------------------------------------------------
// Keystore — stored SSH keys and reusable identities for hosts that are NOT
// bootstrapped with the Shellius CA. Documented, admin-sanctioned exception to
// the "zero static keys" principle: all secret material is AES-256-GCM
// encrypted at rest (utils/crypto), never returned by list/get endpoints, and
// decrypted in memory only at connect/deploy time or on an audited export.
// ---------------------------------------------------------------------------

/// A stored SSH key pair (generated by Shellius or imported).
model SshKey {
  id                  String    @id @default(cuid())
  orgId               String    @map("org_id")
  name                String
  description         String?
  keyType             String    @map("key_type") // ed25519 | rsa | ecdsa
  bits                Int?
  publicKey           String    @map("public_key") @db.Text // OpenSSH one-line format
  privateKeyEncrypted String    @map("private_key_encrypted") @db.Text
  passphraseEncrypted String?   @map("passphrase_encrypted") @db.Text
  fingerprint         String // SHA256:...
  comment             String?
  source              String    @default("generated") // generated | imported
  // Format the key was imported from (normalised to OpenSSH on import):
  // openssh | pkcs1 | pkcs8 | sec1 | ppk2 | ppk3
  originalFormat      String?   @map("original_format")
  // Optional OpenSSH user certificate (…-cert-v01@openssh.com) paired with
  // this key. When present, connections authenticate with the certificate.
  certificate         String?   @db.Text
  createdById         String?   @map("created_by_id")
  // null = organization Keystore; set = personal vault of that user (only
  // they can see or use it — docs/personal-vault.md).
  ownerId             String?   @map("owner_id")
  lastExportedAt      DateTime? @map("last_exported_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        User?           @relation("PersonalSshKeys", fields: [ownerId], references: [id], onDelete: Cascade)
  credentials  Credential[]
  deployments  KeyDeployment[]

  // Personal names are unique per owner. Org names (owner NULL) are checked
  // in keystoreService — Postgres treats NULLs as distinct here.
  @@unique([orgId, ownerId, name])
  @@index([orgId])
  @@index([ownerId])
  @@index([orgId, fingerprint])
  @@map("ssh_keys")
}

/// A reusable identity (username + password and/or key) that can be attached
/// to many servers sharing the same login.
model Credential {
  id                String    @id @default(cuid())
  orgId             String    @map("org_id")
  name              String
  description       String?
  username          String
  authType          String    @map("auth_type") // password | key | key_password
  passwordEncrypted String?   @map("password_encrypted") @db.Text
  sshKeyId          String?   @map("ssh_key_id")
  tags              String[]  @default([])
  createdById       String?   @map("created_by_id")
  // null = organization Keystore; set = personal vault of that user.
  ownerId           String?   @map("owner_id")
  lastUsedAt        DateTime? @map("last_used_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner         User?          @relation("PersonalCredentials", fields: [ownerId], references: [id], onDelete: Cascade)
  sshKey        SshKey?        @relation(fields: [sshKeyId], references: [id], onDelete: Restrict)
  servers       Server[]       @relation("ServerCredential")
  sudoServers   Server[]       @relation("ServerSudoCredential")
  personalHosts PersonalHost[]

  @@unique([orgId, ownerId, name])
  @@index([orgId])
  @@index([sshKeyId])
  @@index([ownerId])
  @@map("credentials")
}

/// One key push/removal against one server. Rows sharing a batchId were
/// submitted together (bulk deploy / rotation).
model KeyDeployment {
  id               String    @id @default(cuid())
  orgId            String    @map("org_id")
  batchId          String    @map("batch_id")
  sshKeyId         String    @map("ssh_key_id")
  serverId         String    @map("server_id")
  action           String    @default("deploy") // deploy | remove | rotate
  targetUser       String    @map("target_user")
  authMode         String    @map("auth_mode") // server | credential | certificate
  authCredentialId String?   @map("auth_credential_id")
  status           String    @default("pending") // pending | running | success | failed
  error            String?
  output           String?   @db.Text
  deployedById     String?   @map("deployed_by_id")
  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sshKey       SshKey       @relation(fields: [sshKeyId], references: [id], onDelete: Cascade)
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([orgId, batchId])
  @@index([sshKeyId])
  @@index([serverId])
  @@map("key_deployments")
}

/// A user's private SSH target ("My hosts"). Not a Server: never in the
/// inventory, policies, approvals or metrics, and only its owner sees it.
/// Connections go through the Quick Connect ticket engine (prod / DENY /
/// target guards) — see docs/personal-vault.md.
model PersonalHost {
  id                 String    @id @default(cuid())
  orgId              String    @map("org_id")
  ownerId            String    @map("owner_id")
  name               String
  host               String
  port               Int       @default(22)
  username           String? // null = the identity's username
  credentialId       String?   @map("credential_id")
  description        String?
  tags               String[]  @default([])
  hostKeyFingerprint String?   @map("host_key_fingerprint")
  hostKeyAlgorithm   String?   @map("host_key_algorithm")
  hostKeyPinnedAt    DateTime? @map("host_key_pinned_at")
  lastConnectedAt    DateTime? @map("last_connected_at")
  lastStatus         String?   @map("last_status") // connected | failed
  lastError          String?   @map("last_error")
  connectCount       Int       @default(0) @map("connect_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  credential   Credential?  @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@unique([ownerId, name])
  @@index([orgId, ownerId])
  @@index([credentialId])
  @@map("personal_hosts")
}

/// Per-user Quick Connect history (dashboard "Recent Quick Connects").
/// Never stores secrets: only the target and how it was authenticated. Rows
/// older than 7 days are pruned; one row per (user, host, port, username).
model QuickConnectHistory {
  id              String   @id @default(cuid())
  orgId           String   @map("org_id")
  userId          String   @map("user_id")
  host            String
  port            Int      @default(22)
  username        String
  authType        String   @map("auth_type") // password | key | credential
  credentialId    String?  @map("credential_id") // identity used, for one-click reconnect
  serverId        String?  @map("server_id") // set when the target matches / was saved as a server
  lastSessionId   String?  @map("last_session_id")
  lastStatus      String   @default("connected") @map("last_status") // connected | failed
  lastError       String?  @map("last_error")
  connectCount    Int      @default(1) @map("connect_count")
  lastConnectedAt DateTime @default(now()) @map("last_connected_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([userId, host, port, username])
  @@index([orgId, userId, lastConnectedAt])
  @@index([lastConnectedAt])
  @@map("quick_connect_history")
}

// ---------------------------------------------------------------------------
// Posture (docs/posture/posture-spec.md)
//
// Exposure posture, not monitoring: what a host exposes, to whom, and whether
// anyone knows why. Findings are long-lived objects that open and close —
// NOT an event per scan — which is what makes "open for 14 days" answerable
// without a time-series store.
// ---------------------------------------------------------------------------

/// One collector run for one host. `raw` keeps the full payload for drift
/// review and is pruned on the org's retention schedule.
model HostSnapshot {
  id             String   @id @default(cuid())
  orgId          String   @map("org_id")
  serverId       String   @map("server_id")
  collectedAt    DateTime @map("collected_at")
  receivedAt     DateTime @default(now()) @map("received_at")
  agentVersion   String?  @map("agent_version")
  // A collector that ran but could not see everything (no container runtime
  // access, unknown firewall engine) is degraded, NOT clean — the difference
  // decides whether a "no findings" report means anything.
  collectorOk    Boolean  @default(true) @map("collector_ok")
  degradedReason String?  @map("degraded_reason")
  firewall       Json     @default("{}")
  raw            Json     @default("{}")

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  server       Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  listeners    HostListener[]
  services     HostService[]

  @@index([orgId, serverId, collectedAt])
  @@index([orgId, receivedAt])
  @@map("host_snapshots")
}

/// A listening socket at a point in time, with the owner resolved from /proc
/// and the reachability verdict for it.
model HostListener {
  id            String  @id @default(cuid())
  orgId         String  @map("org_id")
  serverId      String  @map("server_id")
  snapshotId    String  @map("snapshot_id")
  proto         String
  bind          String
  port          Int
  containerPort Int?    @map("container_port")
  bindClass     String  @map("bind_class") // wildcard | loopback | private | specific
  reachability  String // INTERNET | FIREWALLED | LAN | LOOPBACK | UNKNOWN
  service       String?
  ownerKind     String  @map("owner_kind") // docker | podman | pm2 | systemd | process | unknown
  ownerName     String  @map("owner_name")
  ownerDetail   String? @map("owner_detail") // image / exec path
  ownerRef      String? @map("owner_ref") // container id / pm2 id / unit name
  ownerUser     String? @map("owner_user") // owning unix user — "whose is it" on a shared box
  process       String? @map("process_name") // the listening process's name (nginx, python3) — the last resort for naming it
  sourcePath    String? @map("source_path") // compose file / unit file / cwd — what you edit to change it
  pid           Int?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  snapshot     HostSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([orgId, serverId])
  @@index([orgId, reachability])
  @@index([snapshotId])
  @@map("host_listeners")
}

/// What is INSTALLED on the host, and whether it is actually running.
///
/// HostListener only sees open sockets, so a stopped container, a failed
/// unit or a disabled service is invisible there — while its firewall rule
/// survives, its published port is still declared, and it re-opens the
/// moment the thing starts again. That blind spot is what this closes: a
/// STALE_FIREWALL_RULE could say "nothing is listening on tcp/8080" but
/// never "because the container `api` is stopped", which is the half that
/// tells you whether to delete the rule or restart the service.
///
/// Replaced wholesale on every ingest, like HostListener — this table is
/// the host's current state, never its history.
model HostService {
  id         String    @id @default(cuid())
  orgId      String    @map("org_id")
  serverId   String    @map("server_id")
  snapshotId String    @map("snapshot_id")
  kind       String // docker | podman | pm2 | systemd
  name       String
  ref        String? // container id / unit name / pm2 id
  /// running | exited | created | paused | restarting | failed | inactive | stopped | unknown
  state      String
  /// Denormalised from `state` so "is it up" is an index, not a string list
  /// every caller has to keep in sync.
  running    Boolean   @default(false)
  statusText String?   @map("status_text") // "Exited (1) 2 days ago"
  detail     String? // image / exec path
  sourcePath String?   @map("source_path") // unit file / compose file
  /// Ports the service DECLARES, whether or not anything is listening on
  /// them right now: [{ proto, port, containerPort, bind }]. This is what
  /// makes a stopped container's firewall rule attributable.
  ports      Json      @default("[]")
  exitCode   Int?      @map("exit_code")
  since      DateTime?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  snapshot     HostSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([orgId, serverId])
  @@index([orgId, running])
  @@index([snapshotId])
  @@map("host_services")
}

/// An open exposure problem. Unique per (server, code, proto, port) so a
/// finding that persists across scans stays ONE row with a first-seen date.
model ExposureFinding {
  id               String    @id @default(cuid())
  orgId            String    @map("org_id")
  serverId         String    @map("server_id")
  code             String
  severity         String
  proto            String?
  port             Int?
  service          String?
  ownerLabel       String?   @map("owner_label")
  message          String
  detail           Json      @default("{}")
  firstSeenAt      DateTime  @map("first_seen_at")
  lastSeenAt       DateTime  @map("last_seen_at")
  resolvedAt       DateTime? @map("resolved_at")
  mutedUntil       DateTime? @map("muted_until")
  mutedReason      String?   @map("muted_reason")
  mutedById        String?   @map("muted_by_id")
  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedById String?   @map("acknowledged_by_id")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([orgId, serverId, code, proto, port])
  @@index([orgId, severity, resolvedAt])
  @@index([orgId, serverId])
  @@map("exposure_findings")
}

/// Ports a specific host is *expected* to publish.
///
/// The org-wide list on PostureSettings says "port 8080 is fine everywhere",
/// which is too blunt: 8080 on a demo box is routine, 8080 on a database host
/// is worth knowing about. This is the per-server answer, so silencing one
/// host never silences the fleet. Both lists are consulted; either match
/// downgrades a finding to EXPECTED_PUBLIC.
model ServerExpectedPort {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  serverId    String   @map("server_id")
  port        Int
  /// tcp | udp | any — "any" covers a service that listens on both.
  proto       String   @default("any")
  /// Why this is expected. Required by the API for the same reason a mute
  /// reason is: a suppression with no stated cause is indistinguishable from
  /// a mistake six months later.
  note        String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, port, proto])
  @@index([orgId, serverId])
  @@map("server_expected_ports")
}

/// Resource gauges — ~24h of 1-minute samples, pruned by a job. Deliberately
/// not a TSDB: if someone wants 90-day graphs, that is the signal to deploy
/// Prometheus, not to raise this retention.
model HostMetricSample {
  id       String   @id @default(cuid())
  orgId    String   @map("org_id")
  serverId String   @map("server_id")
  at       DateTime
  cpuPct   Float?   @map("cpu_pct")
  memPct   Float?   @map("mem_pct")
  diskPct  Float?   @map("disk_pct")
  load1    Float?   @map("load_1")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([orgId, serverId, at])
  @@map("host_metric_samples")
}

/// Who gets told about a finding. Routing mirrors access-policy approver
/// routing (roles + group + explicit users) so there is one mental model for
/// "who gets told" across the product.
model PostureAlertRule {
  id                 String   @id @default(cuid())
  orgId              String   @map("org_id")
  name               String
  isActive           Boolean  @default(true) @map("is_active")
  severities         String[] @default([])
  codes              String[] @default([])
  customerIds        String[] @default([]) @map("customer_ids")
  environments       String[] @default([])
  recipientRoles     String[] @default([]) @map("recipient_roles")
  recipientGroupId   String?  @map("recipient_group_id")
  recipientUserIds   String[] @default([]) @map("recipient_user_ids")
  channels           String[] @default(["inapp"])
  mode               String   @default("immediate") // immediate | digest
  notifyOnResolve    Boolean  @default(false) @map("notify_on_resolve")
  throttleMinutes    Int      @default(0) @map("throttle_minutes")
  escalateAfterHours Int?     @map("escalate_after_hours")
  escalateToGroupId  String?  @map("escalate_to_group_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("posture_alert_rules")
}

/// Per-org posture configuration: retention, collector cadence, and the
/// expected-public port list that keeps a deliberate 80/443 from being
/// reported as an incident.
model PostureSettings {
  id                     String   @id @default(cuid())
  orgId                  String   @unique @map("org_id")
  enabled                Boolean  @default(false)
  collectIntervalSeconds Int      @default(300) @map("collect_interval_seconds")
  snapshotRetentionDays  Int      @default(7) @map("snapshot_retention_days")
  metricRetentionHours   Int      @default(24) @map("metric_retention_hours")
  findingRetentionDays   Int      @default(90) @map("finding_retention_days")
  expectedPublicPorts    Json     @default("[]") @map("expected_public_ports")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("posture_settings")
}
